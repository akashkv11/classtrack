generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  classes Class[]

  @@map("academic_years")
}

model Class {
  id             String   @id @default(uuid()) @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  level          String
  stream         String
  displayName    String   @map("display_name")
  whatsappNumber String?  @map("whatsapp_number")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  students           Student[]
  attendanceSessions AttendanceSession[]
  timetableEntries   TimetableEntry[]
  syllabusSubjects      SyllabusSubject[]
  teachingDiaryEntries  TeachingDiaryEntry[]
  assessments           Assessment[]

  @@unique([academicYearId, level, stream])
  @@map("classes")
}

model SyllabusSubject {
  id           String   @id @default(uuid()) @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  subjectName  String   @map("subject_name")
  sourceName   String?  @map("source_name")
  sourceUrl    String?  @map("source_url")
  textbookName String?  @map("textbook_name")
  board        String?
  academicYear String?  @map("academic_year")
  stream       String?
  importMeta   Json?    @map("import_meta")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  class                Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  chapters             SyllabusChapter[]
  teachingDiaryEntries TeachingDiaryEntry[]
  assessments          Assessment[]

  @@map("syllabus_subjects")
}

model SyllabusChapter {
  id                String   @id @default(uuid()) @db.Uuid
  syllabusSubjectId String   @map("syllabus_subject_id") @db.Uuid
  chapterNumber     Int?     @map("chapter_number")
  chapterTitle      String   @map("chapter_title")
  chapterSummary    String?  @map("chapter_summary")
  displayOrder      Int      @default(0) @map("display_order")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  syllabusSubject      SyllabusSubject        @relation(fields: [syllabusSubjectId], references: [id], onDelete: Cascade)
  topics               SyllabusTopic[]
  teachingDiaryEntries TeachingDiaryEntry[]
  assessments          Assessment[]

  @@map("syllabus_chapters")
}

model SyllabusTopic {
  id                String    @id @default(uuid()) @db.Uuid
  syllabusChapterId String    @map("syllabus_chapter_id") @db.Uuid
  topicTitle        String    @map("topic_title")
  topicDescription  String?   @map("topic_description")
  subtopics         Json?
  status            String    @default("NOT_STARTED")
  priority          String    @default("NORMAL")
  estimatedClasses  Int?      @map("estimated_classes")
  targetDate        DateTime? @map("target_date") @db.Date
  startedAt         DateTime? @map("started_at") @db.Date
  completedAt       DateTime? @map("completed_at") @db.Date
  revisedAt         DateTime? @map("revised_at") @db.Date
  remarks           String?
  needsManualReview Boolean   @default(false) @map("needs_manual_review")
  displayOrder      Int       @default(0) @map("display_order")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  syllabusChapter      SyllabusChapter        @relation(fields: [syllabusChapterId], references: [id], onDelete: Cascade)
  teachingDiaryEntries TeachingDiaryEntry[]
  assessmentTopics     AssessmentTopic[]

  @@map("syllabus_topics")
}

model TeachingDiaryEntry {
  id                   String   @id @default(uuid()) @db.Uuid
  classId              String   @map("class_id") @db.Uuid
  syllabusSubjectId    String?  @map("syllabus_subject_id") @db.Uuid
  syllabusChapterId    String?  @map("syllabus_chapter_id") @db.Uuid
  syllabusTopicId      String?  @map("syllabus_topic_id") @db.Uuid
  entryDate            DateTime @map("entry_date") @db.Date
  topicTaught          String   @map("topic_taught")
  teachingNotes        String?  @map("teaching_notes")
  examplesCovered      String?  @map("examples_covered")
  studentResponse      String?  @map("student_response")
  nextClassPlan        String?  @map("next_class_plan")
  diaryStatus          String   @default("TAUGHT") @map("diary_status")
  syllabusStatusUpdate String?  @map("syllabus_status_update")
  remarks              String?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  class           Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  syllabusSubject SyllabusSubject? @relation(fields: [syllabusSubjectId], references: [id], onDelete: SetNull)
  syllabusChapter SyllabusChapter? @relation(fields: [syllabusChapterId], references: [id], onDelete: SetNull)
  syllabusTopic   SyllabusTopic?   @relation(fields: [syllabusTopicId], references: [id], onDelete: SetNull)

  @@index([classId, entryDate])
  @@index([syllabusTopicId])
  @@map("teaching_diary_entries")
}

model TimetableEntry {
  id           String    @id @default(uuid()) @db.Uuid
  classId      String    @map("class_id") @db.Uuid
  subject      String
  scheduleType String    @map("schedule_type")
  entryDate    DateTime? @map("entry_date") @db.Date
  startTime    String    @map("start_time")
  endTime      String    @map("end_time")
  repeatDays         String[]  @map("repeat_days")
  scheduleExceptions Json      @default("[]") @map("schedule_exceptions")
  repeatStart        DateTime? @map("repeat_start") @db.Date
  repeatEnd    DateTime? @map("repeat_end") @db.Date
  notes        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  class Class @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@map("timetable_entries")
}

model Student {
  id          String   @id @default(uuid()) @db.Uuid
  classId     String   @map("class_id") @db.Uuid
  rollNo      Int      @map("roll_no")
  admissionNo String?  @map("admission_no")
  fullName    String   @map("full_name")
  email       String?
  parentPhone String?  @map("parent_phone")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  class              Class              @relation(fields: [classId], references: [id], onDelete: Restrict)
  attendanceRecords  AttendanceRecord[]
  assessmentMarks    AssessmentMark[]

  @@unique([classId, rollNo])
  @@unique([classId, admissionNo])
  @@map("students")
}

model AttendanceSession {
  id             String   @id @default(uuid()) @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  attendanceDate DateTime @map("attendance_date") @db.Date
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  class   Class              @relation(fields: [classId], references: [id], onDelete: Restrict)
  records AttendanceRecord[]

  @@unique([classId, attendanceDate])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  status    String
  remarks   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

model Assessment {
  id                String   @id @default(uuid()) @db.Uuid
  classId           String   @map("class_id") @db.Uuid
  syllabusSubjectId String   @map("syllabus_subject_id") @db.Uuid
  syllabusChapterId String?  @map("syllabus_chapter_id") @db.Uuid
  name              String
  assessmentType    String   @map("assessment_type")
  assessmentDate    DateTime @map("assessment_date") @db.Date
  maxMarks          Int      @map("max_marks")
  remarks           String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  class           Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  syllabusSubject SyllabusSubject   @relation(fields: [syllabusSubjectId], references: [id], onDelete: Restrict)
  syllabusChapter SyllabusChapter?  @relation(fields: [syllabusChapterId], references: [id], onDelete: SetNull)
  topics          AssessmentTopic[]
  marks           AssessmentMark[]

  @@index([classId, assessmentDate])
  @@map("assessments")
}

model AssessmentTopic {
  id              String @id @default(uuid()) @db.Uuid
  assessmentId    String @map("assessment_id") @db.Uuid
  syllabusTopicId String @map("syllabus_topic_id") @db.Uuid

  assessment    Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  syllabusTopic SyllabusTopic @relation(fields: [syllabusTopicId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, syllabusTopicId])
  @@map("assessment_topics")
}

model AssessmentMark {
  id            String   @id @default(uuid()) @db.Uuid
  assessmentId  String   @map("assessment_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  marksObtained Int?     @map("marks_obtained")
  remarks       String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, studentId])
  @@map("assessment_marks")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}
